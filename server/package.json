{
  "name": "api-hit-monitoring",
  "version": "1.0.0",
  "description": "Real-Time API Hit Tracking & Monitoring System",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "processor": "node src/services/processorService/consumer.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:auth": "vitest run test/auth",
    "test:clients": "vitest run test/clients test/users",
    "test:api-keys": "vitest run test/apiKeys",
    "test:ingest": "vitest run test/ingest",
    "test:processing": "vitest run test/processing",
    "test:analytics": "vitest run test/analytics",
    "test:rbac": "vitest run test/authorization",
    "test:reliability": "vitest run test/reliability",
    "test:e2e": "vitest run test/e2e"
  },
  "keywords": [
    "api",
    "monitoring",
    "tracking",
    "analytics"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "amqplib": "^0.10.3",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "pg": "^8.11.3",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
