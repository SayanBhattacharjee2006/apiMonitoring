NODE_ENV="test"
PORT="5001"

SUPER_ADMIN_BOOTSTRAP_SECRET="test-bootstrap-secret-key-1234"

MONGO_URI="mongodb://127.0.0.1:27017/api_monitoring_test"
MONGO_DB_NAME="api_monitoring_test"

PG_HOST="127.0.0.1"
PG_PORT="5433"
PG_DATABASE="api_monitoring_test"
PG_USER="postgres"
