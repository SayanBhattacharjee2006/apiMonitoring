# ==============================================================================
# API Monitoring Platform - Environment Configuration Reference (.env.example)
# Copy this file to .env and supply secure values before starting containers.
# NEVER commit the actual .env file or production secrets to source control.
# ==============================================================================

# Application Environment ('development' | 'test' | 'production')
NODE_ENV=production
PORT=5000

# Process Role ('api' | 'consumer') - set automatically in Dockerfiles
SERVICE_ROLE=api

# ------------------------------------------------------------------------------
# Production Secrets (REQUIRED FOR API PROCESS IN PRODUCTION)
# ------------------------------------------------------------------------------
# JWT_SECRET: Must be a cryptographically strong string with at least 32 characters.
# Insecure defaults, test keys, and common placeholders are rejected in production.
JWT_SECRET=your_production_cryptographically_secure_jwt_secret_min_32_characters

# SUPER_ADMIN_BOOTSTRAP_SECRET: Must be a strong string with at least 16 characters.
# Required for bootstrapping the initial Super Admin account when cluster is initialized.
SUPER_ADMIN_BOOTSTRAP_SECRET=your_production_super_admin_bootstrap_secret_min_16_chars

JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# PostgreSQL Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=api_monitoring
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
PG_HOST=postgres
PG_PORT=5432

# Host port binding (defaults to 127.0.0.1 to avoid untrusted network exposure)
PG_HOST_BIND=127.0.0.1

# ------------------------------------------------------------------------------
# MongoDB Configuration
# ------------------------------------------------------------------------------
MONGO_URI=mongodb://mongo:27017/api_monitoring
MONGO_DB_NAME=api_monitoring

# Host port binding (defaults to 127.0.0.1 to avoid untrusted network exposure)
MONGO_HOST_BIND=127.0.0.1

# ------------------------------------------------------------------------------
# RabbitMQ Message Broker Configuration
# ------------------------------------------------------------------------------
RABBITMQ_USER=api_user
RABBITMQ_PASSWORD=your_secure_rabbitmq_password
RABBITMQ_VHOST=api_monitoring
RABBITMQ_QUEUE=api_hits
RABBITMQ_PUBLISHER_CONFIRMS=true
RABBITMQ_RETRY_ATTEMPTS=3
RABBITMQ_RETRY_DELAY=1000

# Host port binding (defaults to 127.0.0.1 to protect broker and management UI)
RABBITMQ_HOST_BIND=127.0.0.1
RABBITMQ_MGMT_HOST_BIND=127.0.0.1

# ------------------------------------------------------------------------------
# pgAdmin (PostgreSQL Web UI) Configuration
# ------------------------------------------------------------------------------
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=your_secure_pgadmin_password
PGADMIN_HOST_BIND=127.0.0.1

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=100

