# ==============================================================================
# API Monitoring Platform - Environment Configuration Reference (.env.example)
# Copy this file to .env and supply genuine secure values before starting containers.
# NEVER commit the actual .env file or production secrets to source control.
# ==============================================================================

# Application Environment ('development' | 'test' | 'production')
NODE_ENV=production
PORT=5000

# Process Role ('api' | 'consumer') - set automatically in Dockerfiles
SERVICE_ROLE=api

# ------------------------------------------------------------------------------
# Production Secrets (REQUIRED FOR API PROCESS IN PRODUCTION)
# ------------------------------------------------------------------------------
# Generate cryptographically secure secrets before deploying:
#   Using OpenSSL:
#     JWT_SECRET:                   openssl rand -hex 32
#     SUPER_ADMIN_BOOTSTRAP_SECRET: openssl rand -hex 24
#   Using Node.js:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Production configuration strictly validates these values at boot.
# The following will cause FATAL startup failures in production:
#   - Empty or missing secrets
#   - Values under required length (JWT >= 32 chars, Bootstrap >= 16 chars)
#   - Placeholder prefixes (your_*, replace_me_*, example_*, sample_*)
#   - Development/test markers (contains 'test', 'dev', 'placeholder', 'changeme')
# ------------------------------------------------------------------------------
JWT_SECRET=replace_me_with_a_cryptographically_secure_jwt_secret_min_32_chars
SUPER_ADMIN_BOOTSTRAP_SECRET=replace_me_with_a_secure_super_admin_bootstrap_secret_min_16_chars

JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# PostgreSQL Configuration (REQUIRED FOR PRODUCTION DEPLOYMENT)
# ------------------------------------------------------------------------------
# Compose requires POSTGRES_DB, POSTGRES_USER, and POSTGRES_PASSWORD in production.
# Predictable defaults ('postgres') are rejected in production deployments.
POSTGRES_DB=api_monitoring
POSTGRES_USER=api_pg_admin
POSTGRES_PASSWORD=replace_me_with_a_strong_postgres_password_min_16_chars
PG_HOST=postgres
PG_PORT=5432

# Host port binding (defaults to 127.0.0.1 to avoid untrusted network exposure)
PG_HOST_BIND=127.0.0.1

# ------------------------------------------------------------------------------
# MongoDB Configuration (REQUIRED FOR PRODUCTION DEPLOYMENT)
# ------------------------------------------------------------------------------
MONGO_URI=mongodb://mongo:27017/api_monitoring
MONGO_DB_NAME=api_monitoring

# Host port binding (defaults to 127.0.0.1 to avoid untrusted network exposure)
MONGO_HOST_BIND=127.0.0.1

# ------------------------------------------------------------------------------
# RabbitMQ Message Broker Configuration (REQUIRED FOR PRODUCTION DEPLOYMENT)
# ------------------------------------------------------------------------------
# Compose requires RABBITMQ_USER, RABBITMQ_PASSWORD, and RABBITMQ_VHOST in production.
# Predictable defaults ('api_user' / 'secure_password') must be replaced.
RABBITMQ_USER=api_broker_user
RABBITMQ_PASSWORD=replace_me_with_a_strong_rabbitmq_password_min_16_chars
RABBITMQ_VHOST=api_monitoring
RABBITMQ_QUEUE=api_hits
RABBITMQ_PUBLISHER_CONFIRMS=true
RABBITMQ_RETRY_ATTEMPTS=3
RABBITMQ_RETRY_DELAY=1000

# Host port binding (defaults to 127.0.0.1 to protect broker and management UI)
RABBITMQ_HOST_BIND=127.0.0.1
RABBITMQ_MGMT_HOST_BIND=127.0.0.1

# ------------------------------------------------------------------------------
# pgAdmin (PostgreSQL Web UI) Configuration
# ------------------------------------------------------------------------------
# Compose requires PGADMIN_EMAIL and PGADMIN_PASSWORD when pgAdmin is started.
PGADMIN_EMAIL=admin@your-company.com
PGADMIN_PASSWORD=replace_me_with_a_strong_pgadmin_password_min_16_chars
PGADMIN_HOST_BIND=127.0.0.1

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=100
